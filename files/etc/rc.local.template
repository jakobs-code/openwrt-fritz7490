# Put your custom commands here that should be executed once
# the system init finished.

# Warte bis lan-wasp Interface oben ist
ok=0
while true; do
  if ip link show lan-wasp | grep -q "state UP"; then
    ok=$(($ok+1))
  else
    ok=0
  fi
  if [ $ok -gt 10 ]; then
    break
  fi
  sleep 1
done

# avm_wasp-Modul neu laden (startet den WLAN-Prozessor)
if lsmod | grep -q avm_wasp ; then
  rmmod avm_wasp
fi
sleep 1
modprobe avm_wasp

# WASP-Konfiguration im Hintergrund einspielen (Bootfix: Retry + Verifikation)
( /etc/wasp-bootfix.sh ) &

exit 0
