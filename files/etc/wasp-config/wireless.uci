config wifi-device 'radio0'
	option type 'mac80211'
	option path 'pci0000:00/0000:00:00.0'
	option band '5g'
	option channel '44'
	option htmode 'HT40'
	option country 'DE'
	option disabled '0'

config wifi-iface 'ap_flat'
	option device 'radio0'
	option mode 'ap'
	option ssid 'securelabs'
	option encryption 'psk2+ccmp'
	option key 'l8wwCgvNFNI2i2ESf6Jn'
	option network 'lan'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/ahb/18100000.wmac'
	option band '2g'
	option channel '13'
	option htmode 'HT40'
	option country 'DE'
	option disabled '0'

config wifi-iface 'sta_uplink'
	option device 'radio1'
	option mode 'sta'
	option ssid 'Theo38'
	option encryption 'psk2'
	option key 'MachMirEinBananenbrot'
	option network 'wwan'
